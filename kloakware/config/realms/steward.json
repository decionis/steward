      "redirectUris": [
        "$(env:STEWARD_FAPI_URL:-https://steward.example)/api/auth/oidc/callback"
      ],
      "webOrigins": [],
      "attributes": {
        "steward.fapi": "mtls",
        "jwt.credential.certificate": "$(env:KLOAKWARE_FAPI_CLIENT_CERTIFICATE)",
        "token.endpoint.auth.signing.alg": "PS256",
        "access.token.signed.response.alg": "PS256",
        "id.token.signed.response.alg": "PS256",
        "pkce.code.challenge.method": "S256",
        "require.pushed.authorization.requests": "true",
        "tls.client.certificate.bound.access.tokens": "true",
        "dpop.bound.access.tokens": "false",
        "use.refresh.tokens": "true",
        "backchannel.logout.url": "$(env:STEWARD_FAPI_URL:-https://steward.example)/api/auth/oidc/backchannel-logout",
        "backchannel.logout.session.required": "true",
        "post.logout.redirect.uris": "$(env:STEWARD_FAPI_URL:-https://steward.example)/sign-in",
        "oauth2.device.authorization.grant.enabled": "false",
        "oidc.ciba.grant.enabled": "false"
      },
      "defaultClientScopes": ["basic", "steward", "profile", "email", "acr"],
      "optionalClientScopes": [],
      "fullScopeAllowed": false
    },
    {
      "clientId": "steward-fapi-dpop",
      "name": "Steward, financial grade (DPoP)",
      "description": "The same profile with DPoP as the sender constraint: the client proves possession of a key on every request, which an ingress that cannot pass a certificate still allows (K11).",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
