{
  "realm": "steward",
  "displayName": "Steward",
  "enabled": true,
  "sslRequired": "external",
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": false,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 10,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "maxDeltaTimeSeconds": 43200,
  "minimumQuickLoginWaitSeconds": 60,
  "quickLoginCheckMilliSeconds": 1000,
  "passwordPolicy": "length(12) and maxLength(128) and digits(1) and lowerCase(1) and upperCase(1) and specialChars(1) and notUsername and notEmail and passwordHistory(5)",
  "defaultSignatureAlgorithm": "RS256",
  "accessTokenLifespan": 300,
  "accessCodeLifespan": 60,
  "accessCodeLifespanLogin": 1800,
  "accessCodeLifespanUserAction": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "browserFlow": "steward-browser",
  "roles": {
    "realm": [
      {
        "name": "steward-viewer",
        "description": "Sees the queue, the accounts and the evidence. The floor: every signed-in user holds it."
      },
      {
        "name": "steward-operator",
        "description": "Collects signals and works the queue."
      },
      {
        "name": "steward-approver",
        "description": "Records reviews: approve, hold, reject."
      },
      {
        "name": "steward-operations",
        "description": "The technical team: signal sources and collections, the workspace connection, health. Records no review."
      },
      {
        "name": "steward-audits",
        "description": "Reads every record Steward keeps. Changes nothing."
      },
      {
        "name": "steward-admin",
        "description": "Everything, including users and the workspace connection."
      },
      {
        "name": "default-roles-steward",
        "description": "${role_default-roles}",
        "composite": true,
        "composites": {
          "realm": ["steward-viewer"],
          "client": {
            "account": ["view-profile", "manage-account"]
          }
        }
      }
    ]
  },
  "groups": [
    {
      "name": "markets",
      "attributes": {},
      "subGroups": [
        {
          "name": "SE",
          "attributes": {
            "market": ["SE"]
          }
        },
        {
          "name": "NG",
          "attributes": {
            "market": ["NG"]
          }
        },
        {
          "name": "GB",
          "attributes": {
            "market": ["GB"]
          }
        },
        {
          "name": "DE",
          "attributes": {
            "market": ["DE"]
          }
        }
      ]
    }
  ],
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "providerId": "declarative-user-profile",
        "subComponents": {},
        "config": {
          "kc.user.profile.config": [
            "{\"attributes\": [{\"name\": \"username\", \"displayName\": \"${username}\", \"validations\": {\"length\": {\"min\": 3, \"max\": 255}, \"username-prohibited-characters\": {}, \"up-username-not-idn-homograph\": {}}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"multivalued\": false}, {\"name\": \"email\", \"displayName\": \"${email}\", \"validations\": {\"email\": {}, \"length\": {\"max\": 255}}, \"required\": {\"roles\": [\"user\"]}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"multivalued\": false}, {\"name\": \"firstName\", \"displayName\": \"${firstName}\", \"validations\": {\"length\": {\"max\": 255}, \"person-name-prohibited-characters\": {}}, \"required\": {\"roles\": [\"user\"]}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"multivalued\": false}, {\"name\": \"lastName\", \"displayName\": \"${lastName}\", \"validations\": {\"length\": {\"max\": 255}, \"person-name-prohibited-characters\": {}}, \"required\": {\"roles\": [\"user\"]}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"multivalued\": false}, {\"name\": \"market\", \"displayName\": \"Market\", \"validations\": {\"options\": {\"options\": [\"SE\", \"NG\", \"GB\", \"DE\"]}}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\"]}, \"multivalued\": true, \"annotations\": {\"inputType\": \"multiselect\"}}, {\"name\": \"personalNumber\", \"displayName\": \"Personal number\", \"validations\": {\"pattern\": {\"pattern\": \"^[0-9]{12}$\", \"error-message\": \"Twelve digits, YYYYMMDDNNNN\"}}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\"]}, \"multivalued\": false, \"annotations\": {\"inputType\": \"text\"}}], \"groups\": [{\"name\": \"user-metadata\", \"displayHeader\": \"User metadata\", \"displayDescription\": \"Attributes, which refer to user metadata\"}]}"
          ]
        }
      }
    ]
  },
  "clientScopes": [
    {
      "name": "market",
      "description": "The markets the user works: their own attribute and the markets groups they belong to, as one multivalued claim.",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "market",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "market",
            "claim.name": "market",
            "jsonType.label": "String",
            "multivalued": "true",
            "aggregate.attrs": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "steward",
      "description": "What Steward needs and nothing else: the user's Steward roles and markets as one claim, from the steward claim mapper compiled into this server.",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "steward claim",
          "protocol": "openid-connect",
          "protocolMapper": "steward-claim-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "steward",
            "role.prefix": "steward-",
            "markets.group.path": "/markets",
            "market.attribute": "market",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "lightweight.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "subject",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "consentRequired": false,
          "config": {
            "access.token.claim": "true",
            "introspection.token.claim": "true",
            "lightweight.claim": "true"
          }
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "steward",
      "name": "Steward",
      "description": "The Steward application: a confidential client, the code flow with PKCE from the server, backchannel logout, no browser-side token. Full scope off, a lightweight access token: the steward claim and nothing more.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "$(env:KLOAKWARE_STEWARD_CLIENT_SECRET)",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "consentRequired": false,
      "frontchannelLogout": false,
      "rootUrl": "$(env:STEWARD_URL)",
      "baseUrl": "/",
      "redirectUris": ["$(env:STEWARD_URL)/api/auth/oidc/callback"],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "backchannel.logout.url": "$(env:STEWARD_URL)/api/auth/oidc/backchannel-logout",
        "backchannel.logout.session.required": "true",
        "backchannel.logout.revoke.offline.tokens": "false",
        "post.logout.redirect.uris": "$(env:STEWARD_URL)/sign-in",
        "use.refresh.tokens": "true",
        "oauth2.device.authorization.grant.enabled": "false",
        "oidc.ciba.grant.enabled": "false",
        "client.use.lightweight.access.token.enabled": "true"
      },
      "defaultClientScopes": [
        "basic",
        "steward",
        "profile",
        "email",
        "web-origins",
        "acr"
      ],
      "optionalClientScopes": [],
      "fullScopeAllowed": false
    },
    {
      "clientId": "steward-api",
      "name": "Steward API",
      "description": "The resource server under Authorization Services: a review in a market needs the approver role and that market; a view needs the market. Decided through the token endpoint's UMA grant; the platform stays the control.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "$(env:KLOAKWARE_STEWARD_API_SECRET)",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "authorizationServicesEnabled": true,
      "fullScopeAllowed": false,
      "defaultClientScopes": ["basic"],
      "optionalClientScopes": [],
      "redirectUris": [],
      "webOrigins": [],
      "authorizationSettings": {
        "allowRemoteResourceManagement": false,
        "policyEnforcementMode": "ENFORCING",
        "decisionStrategy": "UNANIMOUS",
        "scopes": [
          {
            "name": "view"
          },
          {
            "name": "review"
          }
        ],
        "resources": [
          {
            "name": "opportunity:SE",
            "displayName": "Opportunities in SE",
            "type": "urn:steward:opportunity",
            "ownerManagedAccess": false,
            "attributes": {
              "market": ["SE"]
            },
            "scopes": [
              {
                "name": "view"
              },
              {
                "name": "review"
              }
            ]
          },
          {
            "name": "opportunity:NG",
            "displayName": "Opportunities in NG",
            "type": "urn:steward:opportunity",
            "ownerManagedAccess": false,
            "attributes": {
              "market": ["NG"]
            },
            "scopes": [
              {
                "name": "view"
              },
              {
                "name": "review"
              }
            ]
          },
          {
            "name": "opportunity:GB",
            "displayName": "Opportunities in GB",
            "type": "urn:steward:opportunity",
            "ownerManagedAccess": false,
            "attributes": {
              "market": ["GB"]
            },
            "scopes": [
              {
                "name": "view"
              },
              {
                "name": "review"
              }
            ]
          },
          {
            "name": "opportunity:DE",
            "displayName": "Opportunities in DE",
            "type": "urn:steward:opportunity",
            "ownerManagedAccess": false,
            "attributes": {
              "market": ["DE"]
            },
            "scopes": [
              {
                "name": "view"
              },
              {
                "name": "review"
              }
            ]
          }
        ],
        "policies": [
          {
            "name": "approvers",
            "type": "role",
            "logic": "POSITIVE",
            "decisionStrategy": "UNANIMOUS",
            "config": {
              "roles": "[{\"id\": \"steward-approver\", \"required\": true}]",
              "fetchRoles": "true"
            }
          },
          {
            "name": "market SE",
            "type": "group",
            "logic": "POSITIVE",
            "decisionStrategy": "UNANIMOUS",
            "config": {
              "groups": "[{\"path\": \"/markets/SE\", \"extendChildren\": false}]",
              "groupsClaim": ""
            }
          },
          {
            "name": "market NG",
            "type": "group",
            "logic": "POSITIVE",
            "decisionStrategy": "UNANIMOUS",
            "config": {
              "groups": "[{\"path\": \"/markets/NG\", \"extendChildren\": false}]",
              "groupsClaim": ""
            }
          },
          {
            "name": "market GB",
            "type": "group",
            "logic": "POSITIVE",
            "decisionStrategy": "UNANIMOUS",
            "config": {
              "groups": "[{\"path\": \"/markets/GB\", \"extendChildren\": false}]",
              "groupsClaim": ""
            }
          },
          {
            "name": "market DE",
            "type": "group",
            "logic": "POSITIVE",
            "decisionStrategy": "UNANIMOUS",
            "config": {
              "groups": "[{\"path\": \"/markets/DE\", \"extendChildren\": false}]",
              "groupsClaim": ""
            }
          },
          {
            "name": "review in SE",
            "type": "scope",
            "logic": "POSITIVE",
            "decisionStrategy": "UNANIMOUS",
            "config": {
              "resources": "[\"opportunity:SE\"]",
              "scopes": "[\"review\"]",
              "applyPolicies": "[\"approvers\", \"market SE\"]"
            }
          },
          {
            "name": "review in NG",
            "type": "scope",
            "logic": "POSITIVE",
            "decisionStrategy": "UNANIMOUS",
            "config": {
              "resources": "[\"opportunity:NG\"]",
              "scopes": "[\"review\"]",
              "applyPolicies": "[\"approvers\", \"market NG\"]"
            }
          },
          {
            "name": "review in GB",
            "type": "scope",
            "logic": "POSITIVE",
            "decisionStrategy": "UNANIMOUS",
            "config": {
              "resources": "[\"opportunity:GB\"]",
              "scopes": "[\"review\"]",
              "applyPolicies": "[\"approvers\", \"market GB\"]"
            }
          },
          {
            "name": "review in DE",
            "type": "scope",
            "logic": "POSITIVE",
            "decisionStrategy": "UNANIMOUS",
            "config": {
              "resources": "[\"opportunity:DE\"]",
              "scopes": "[\"review\"]",
              "applyPolicies": "[\"approvers\", \"market DE\"]"
            }
          },
          {
            "name": "view in SE",
            "type": "scope",
            "logic": "POSITIVE",
            "decisionStrategy": "UNANIMOUS",
            "config": {
              "resources": "[\"opportunity:SE\"]",
              "scopes": "[\"view\"]",
              "applyPolicies": "[\"market SE\"]"
            }
          },
          {
            "name": "view in NG",
            "type": "scope",
            "logic": "POSITIVE",
            "decisionStrategy": "UNANIMOUS",
            "config": {
              "resources": "[\"opportunity:NG\"]",
              "scopes": "[\"view\"]",
              "applyPolicies": "[\"market NG\"]"
            }
          },
          {
            "name": "view in GB",
            "type": "scope",
            "logic": "POSITIVE",
            "decisionStrategy": "UNANIMOUS",
            "config": {
              "resources": "[\"opportunity:GB\"]",
              "scopes": "[\"view\"]",
              "applyPolicies": "[\"market GB\"]"
            }
          },
          {
            "name": "view in DE",
            "type": "scope",
            "logic": "POSITIVE",
            "decisionStrategy": "UNANIMOUS",
            "config": {
              "resources": "[\"opportunity:DE\"]",
              "scopes": "[\"view\"]",
              "applyPolicies": "[\"market DE\"]"
            }
          }
        ]
      }
    }
  ],
  "authenticationFlows": [
    {
      "alias": "steward-browser",
      "description": "The browser flow Steward's sign-in goes through: cookie, identity-provider redirector, then the forms. A copy of the built-in flow so that K5 can add the market second factor without touching a built-in.",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-cookie",
          "requirement": "ALTERNATIVE",
          "priority": 10,
          "userSetupAllowed": false,
          "authenticatorFlow": false
        },
        {
          "authenticator": "identity-provider-redirector",
          "requirement": "ALTERNATIVE",
          "priority": 20,
          "userSetupAllowed": false,
          "authenticatorFlow": false
        },
        {
          "flowAlias": "steward-browser forms",
          "requirement": "ALTERNATIVE",
          "priority": 30,
          "userSetupAllowed": false,
          "authenticatorFlow": true
        }
      ]
    },
    {
      "alias": "steward-browser forms",
      "description": "Username, password, the second factor the user's market requires, then a TOTP for the users who have one.",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-username-password-form",
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false,
          "authenticatorFlow": false
        },
        {
          "authenticator": "steward-market-second-factor",
          "authenticatorConfig": "market second factor",
          "requirement": "REQUIRED",
          "priority": 15,
          "userSetupAllowed": false,
          "authenticatorFlow": false
        },
        {
          "flowAlias": "steward-browser second factor",
          "requirement": "CONDITIONAL",
          "priority": 20,
          "userSetupAllowed": false,
          "authenticatorFlow": true
        }
      ]
    },
    {
      "alias": "steward-browser second factor",
      "description": "OTP when the user has configured one. K5 adds the market-conditioned step here.",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "conditional-user-configured",
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false,
          "authenticatorFlow": false
        },
        {
          "authenticator": "auth-otp-form",
          "requirement": "REQUIRED",
          "priority": 20,
          "userSetupAllowed": false,
          "authenticatorFlow": false
        }
      ]
    }
  ],
  "eventsEnabled": true,
  "eventsListeners": ["jboss-logging", "steward-audit"],
  "enabledEventTypes": [],
  "adminEventsEnabled": true,
  "adminEventsDetailsEnabled": false,
  "authenticatorConfig": [
    {
      "alias": "market second factor",
      "config": {
        "markets": "SE",
        "method": "bankid",
        "bankid.url": "$(env:KLOAKWARE_BANKID_URL)",
        "bankid.personal-number-attribute": "personalNumber",
        "markets.group.path": "/markets",
        "market.attribute": "market"
      }
    }
  ]
}
