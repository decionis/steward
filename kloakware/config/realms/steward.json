    {
      "clientId": "legacy-dashboard",
      "name": "The legacy dashboard",
      "description": "The application that stood behind the SiteMinder agent, now an OIDC client (K13): the code flow with PKCE, the full profile in the access token, since the agent shim sets SM_USER from it. Retired with the legacy system.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
