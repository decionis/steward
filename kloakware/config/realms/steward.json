{
  "realm": "steward",
  "displayName": "Steward",
  "enabled": true,
  "sslRequired": "external",
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": false,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 10,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "maxDeltaTimeSeconds": 43200,
  "minimumQuickLoginWaitSeconds": 60,
  "quickLoginCheckMilliSeconds": 1000,
  "passwordPolicy": "length(12) and maxLength(128) and digits(1) and lowerCase(1) and upperCase(1) and specialChars(1) and notUsername and notEmail and passwordHistory(5)",
  "defaultSignatureAlgorithm": "RS256",
  "accessTokenLifespan": 300,
  "accessCodeLifespan": 60,
  "accessCodeLifespanLogin": 1800,
  "accessCodeLifespanUserAction": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "internationalizationEnabled": true,
  "supportedLocales": ["en", "sv", "de"],
  "defaultLocale": "en",
  "emailTheme": "steward",
  "accountTheme": "steward",
  "smtpServer": {
    "host": "$(env:KLOAKWARE_SMTP_HOST:-mail)",
    "port": "$(env:KLOAKWARE_SMTP_PORT:-1025)",
    "from": "$(env:KLOAKWARE_SMTP_FROM:-no-reply@steward.example)",
    "fromDisplayName": "Steward",
    "auth": "false",
    "ssl": "false",
    "starttls": "false"
  },
  "browserFlow": "steward-browser",
  "webAuthnPolicyRpEntityName": "Kloakware",
  "webAuthnPolicySignatureAlgorithms": ["ES256", "RS256"],
  "webAuthnPolicyRpId": "",
  "webAuthnPolicyAttestationConveyancePreference": "none",
  "webAuthnPolicyAuthenticatorAttachment": "not specified",
  "webAuthnPolicyRequireResidentKey": "not specified",
  "webAuthnPolicyUserVerificationRequirement": "preferred",
  "webAuthnPolicyCreateTimeout": 0,
  "webAuthnPolicyAvoidSameAuthenticatorRegister": false,
  "webAuthnPolicyAcceptableAaguids": [],
  "webAuthnPolicyExtraOrigins": [],
  "roles": {
    "realm": [
      {
        "name": "steward-viewer",
        "description": "Sees the queue, the accounts and the evidence. The floor: every signed-in user holds it."
      },
      {
        "name": "steward-operator",
        "description": "Collects signals and works the queue."
      },
      {
        "name": "steward-approver",
        "description": "Records reviews: approve, hold, reject."
      },
      {
        "name": "steward-operations",
        "description": "The technical team: signal sources and collections, the workspace connection, health. Records no review."
      },
      {
        "name": "steward-audits",
        "description": "Reads every record Steward keeps. Changes nothing."
      },
      {
        "name": "steward-admin",
        "description": "Everything, including users and the workspace connection."
      },
      {
        "name": "default-roles-steward",
        "description": "${role_default-roles}",
        "composite": true,
        "composites": {
          "realm": ["steward-viewer"],
          "client": {
            "account": ["view-profile", "manage-account"]
          }
        }
      }
    ]
  },
  "groups": [
    {
      "name": "markets",
      "attributes": {},
      "subGroups": [
        {
          "name": "SE",
          "attributes": {
            "market": ["SE"]
          }
        },
        {
          "name": "NG",
          "attributes": {
            "market": ["NG"]
          }
        },
        {
          "name": "GB",
          "attributes": {
            "market": ["GB"]
          }
        },
        {
          "name": "DE",
          "attributes": {
            "market": ["DE"]
          }
        }
      ]
    }
  ],
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "providerId": "declarative-user-profile",
        "subComponents": {},
        "config": {
          "kc.user.profile.config": [
            "{\"attributes\": [{\"name\": \"username\", \"displayName\": \"${username}\", \"validations\": {\"length\": {\"min\": 3, \"max\": 255}, \"username-prohibited-characters\": {}, \"up-username-not-idn-homograph\": {}}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"multivalued\": false}, {\"name\": \"email\", \"displayName\": \"${email}\", \"validations\": {\"email\": {}, \"length\": {\"max\": 255}}, \"required\": {\"roles\": [\"user\"]}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"multivalued\": false}, {\"name\": \"firstName\", \"displayName\": \"${firstName}\", \"validations\": {\"length\": {\"max\": 255}, \"person-name-prohibited-characters\": {}}, \"required\": {\"roles\": [\"user\"]}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"multivalued\": false}, {\"name\": \"lastName\", \"displayName\": \"${lastName}\", \"validations\": {\"length\": {\"max\": 255}, \"person-name-prohibited-characters\": {}}, \"required\": {\"roles\": [\"user\"]}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"multivalued\": false}, {\"name\": \"market\", \"displayName\": \"Market\", \"validations\": {\"options\": {\"options\": [\"SE\", \"NG\", \"GB\", \"DE\"]}}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\"]}, \"multivalued\": true, \"annotations\": {\"inputType\": \"multiselect\"}}, {\"name\": \"personalNumber\", \"displayName\": \"Personal number\", \"validations\": {\"pattern\": {\"pattern\": \"^[0-9]{12}$\", \"error-message\": \"Twelve digits, YYYYMMDDNNNN\"}}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\"]}, \"multivalued\": false, \"annotations\": {\"inputType\": \"text\"}}, {\"name\": \"stewardId\", \"displayName\": \"Steward id\", \"permissions\": {\"view\": [\"admin\"], \"edit\": [\"admin\"]}, \"multivalued\": false}, {\"name\": \"legacySource\", \"displayName\": \"Migrated from\", \"permissions\": {\"view\": [\"admin\"], \"edit\": [\"admin\"]}, \"multivalued\": false}], \"groups\": [{\"name\": \"user-metadata\", \"displayHeader\": \"User metadata\", \"displayDescription\": \"Attributes, which refer to user metadata\"}]}"
          ]
        }
      }
    ],
    "org.keycloak.storage.UserStorageProvider": [
      {
        "name": "steward-users",
        "providerId": "steward-users",
        "subComponents": {},
        "config": {
          "enabled": ["true"],
          "priority": ["10"],
          "cachePolicy": ["MAX_LIFESPAN"],
          "jdbcUrl": [
            "$(env:STEWARD_DB_JDBC_URL:-jdbc:postgresql://db:5432/steward)"
          ],
          "jdbcUser": ["$(env:STEWARD_DB_USER:-steward)"],
          "jdbcPassword": ["$(env:STEWARD_DB_PASSWORD)"],
          "rolePrefix": ["steward-"],
          "maxLifespan": ["300000"]
        }
      },
      {
        "name": "ldap",
        "providerId": "ldap",
        "subComponents": {
          "org.keycloak.storage.ldap.mappers.LDAPStorageMapper": [
            {
              "name": "username",
              "providerId": "user-attribute-ldap-mapper",
              "subComponents": {},
              "config": {
                "ldap.attribute": ["uid"],
                "user.model.attribute": ["username"],
                "read.only": ["true"],
                "always.read.value.from.ldap": ["false"],
                "is.mandatory.in.ldap": ["true"]
              }
            },
            {
              "name": "email",
              "providerId": "user-attribute-ldap-mapper",
              "subComponents": {},
              "config": {
                "ldap.attribute": ["mail"],
                "user.model.attribute": ["email"],
                "read.only": ["true"],
                "always.read.value.from.ldap": ["false"],
                "is.mandatory.in.ldap": ["false"]
              }
            },
            {
              "name": "first name",
              "providerId": "user-attribute-ldap-mapper",
              "subComponents": {},
              "config": {
                "ldap.attribute": ["givenName"],
                "user.model.attribute": ["firstName"],
                "read.only": ["true"],
                "always.read.value.from.ldap": ["true"],
                "is.mandatory.in.ldap": ["false"]
              }
            },
            {
              "name": "last name",
              "providerId": "user-attribute-ldap-mapper",
              "subComponents": {},
              "config": {
                "ldap.attribute": ["sn"],
                "user.model.attribute": ["lastName"],
                "read.only": ["true"],
                "always.read.value.from.ldap": ["true"],
                "is.mandatory.in.ldap": ["true"]
              }
            },
            {
              "name": "market",
              "providerId": "user-attribute-ldap-mapper",
              "subComponents": {},
              "config": {
                "ldap.attribute": ["departmentNumber"],
                "user.model.attribute": ["market"],
                "read.only": ["true"],
                "always.read.value.from.ldap": ["true"],
                "is.mandatory.in.ldap": ["false"]
              }
            },
            {
              "name": "markets",
              "providerId": "group-ldap-mapper",
              "subComponents": {},
              "config": {
                "groups.dn": ["ou=markets,dc=steward,dc=example"],
                "group.name.ldap.attribute": ["cn"],
                "group.object.classes": ["groupOfNames"],
                "preserve.group.inheritance": ["false"],
                "ignore.missing.groups": ["false"],
                "membership.ldap.attribute": ["member"],
                "membership.attribute.type": ["DN"],
                "membership.user.ldap.attribute": ["uid"],
                "groups.ldap.filter": [""],
                "mode": ["READ_ONLY"],
                "user.roles.retrieve.strategy": [
                  "LOAD_GROUPS_BY_MEMBER_ATTRIBUTE"
                ],
                "mapped.group.attributes": [""],
                "drop.non.existing.groups.during.sync": ["false"],
                "groups.path": ["/markets"]
              }
            },
            {
              "name": "steward roles",
              "providerId": "role-ldap-mapper",
              "subComponents": {},
              "config": {
                "roles.dn": ["ou=roles,dc=steward,dc=example"],
                "role.name.ldap.attribute": ["cn"],
                "role.object.classes": ["groupOfNames"],
                "membership.ldap.attribute": ["member"],
                "membership.attribute.type": ["DN"],
                "membership.user.ldap.attribute": ["uid"],
                "roles.ldap.filter": [""],
                "mode": ["READ_ONLY"],
                "user.roles.retrieve.strategy": [
                  "LOAD_ROLES_BY_MEMBER_ATTRIBUTE"
                ],
                "use.realm.roles.mapping": ["true"]
              }
            }
          ]
        },
        "config": {
          "enabled": ["true"],
          "priority": ["20"],
          "editMode": ["READ_ONLY"],
          "importEnabled": ["true"],
          "syncRegistrations": ["false"],
          "vendor": ["other"],
          "usernameLDAPAttribute": ["uid"],
          "rdnLDAPAttribute": ["uid"],
          "uuidLDAPAttribute": ["entryUUID"],
          "userObjectClasses": ["inetOrgPerson, organizationalPerson"],
          "connectionUrl": ["$(env:KLOAKWARE_LDAP_URL:-ldap://ldap:389)"],
          "usersDn": ["ou=people,dc=steward,dc=example"],
          "authType": ["simple"],
          "bindDn": ["cn=admin,dc=steward,dc=example"],
          "bindCredential": ["$(env:KLOAKWARE_LDAP_BIND_PASSWORD)"],
          "searchScope": ["1"],
          "pagination": ["true"],
          "batchSizeForSync": ["1000"],
          "fullSyncPeriod": ["-1"],
          "changedSyncPeriod": ["300"],
          "cachePolicy": ["MAX_LIFESPAN"],
          "trustEmail": ["true"],
          "useTruststoreSpi": ["always"],
          "connectionPooling": ["true"],
          "connectionTimeout": ["5000"],
          "readTimeout": ["5000"],
          "removeInvalidUsersEnabled": ["true"],
          "validatePasswordPolicy": ["false"],
          "startTls": ["false"],
          "maxLifespan": ["300000"]
        }
      }
    ],
    "org.keycloak.keys.KeyProvider": [
      {
        "name": "rsa-generated",
        "providerId": "rsa-generated",
        "subComponents": {},
        "config": {
          "priority": ["100"]
        }
      },
      {
        "name": "rsa-enc-generated",
        "providerId": "rsa-enc-generated",
        "subComponents": {},
        "config": {
          "priority": ["100"],
          "algorithm": ["RSA-OAEP"]
        }
      },
      {
        "name": "hmac-generated-hs512",
        "providerId": "hmac-generated",
        "subComponents": {},
        "config": {
          "priority": ["100"],
          "algorithm": ["HS512"]
        }
      },
      {
        "name": "aes-generated",
        "providerId": "aes-generated",
        "subComponents": {},
        "config": {
          "priority": ["100"]
        }
      },
      {
        "name": "rsa-ps256-generated",
        "providerId": "rsa-generated",
        "subComponents": {},
        "config": {
          "priority": ["100"],
          "algorithm": ["PS256"],
          "keySize": ["2048"]
        }
      }
    ]
  },
  "clientScopes": [
    {
      "name": "market",
      "description": "The markets the user works: their own attribute and the markets groups they belong to, as one multivalued claim.",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "market",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "market",
            "claim.name": "market",
            "jsonType.label": "String",
            "multivalued": "true",
            "aggregate.attrs": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "steward",
      "description": "What Steward needs and nothing else: the user's Steward roles and markets as one claim, from the steward claim mapper compiled into this server; and the API named as the audience, which is what lets it introspect the token (K11).",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "steward claim",
          "protocol": "openid-connect",
          "protocolMapper": "steward-claim-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "steward",
            "role.prefix": "steward-",
            "markets.group.path": "/markets",
            "market.attribute": "market",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "lightweight.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "subject",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "consentRequired": false,
          "config": {
            "access.token.claim": "true",
            "introspection.token.claim": "true",
            "lightweight.claim": "true"
          }
        },
        {
          "name": "api audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "steward-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "lightweight.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "steward",
      "name": "Steward",
      "description": "The Steward application: a confidential client, the code flow with PKCE from the server, backchannel logout, no browser-side token. Full scope off, a lightweight access token: the steward claim and nothing more.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "$(env:KLOAKWARE_STEWARD_CLIENT_SECRET)",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "consentRequired": false,
      "frontchannelLogout": false,
      "rootUrl": "$(env:STEWARD_URL)",
      "baseUrl": "/",
      "redirectUris": ["$(env:STEWARD_URL)/api/auth/oidc/callback"],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "backchannel.logout.url": "$(env:STEWARD_URL)/api/auth/oidc/backchannel-logout",
        "backchannel.logout.session.required": "true",
        "backchannel.logout.revoke.offline.tokens": "false",
        "post.logout.redirect.uris": "$(env:STEWARD_URL)/sign-in",
        "use.refresh.tokens": "true",
        "oauth2.device.authorization.grant.enabled": "false",
        "oidc.ciba.grant.enabled": "false",
        "client.use.lightweight.access.token.enabled": "true",
        "login_theme": "steward"
      },
      "defaultClientScopes": [
        "basic",
        "steward",
        "profile",
        "email",
        "web-origins",
        "acr"
      ],
      "optionalClientScopes": [],
      "fullScopeAllowed": false
    },
    {
      "clientId": "steward-api",
      "name": "Steward API",
      "description": "The resource server under Authorization Services: a review in a market needs the approver role and that market; a view needs the market. Decided through the token endpoint's UMA grant; the platform stays the control.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "$(env:KLOAKWARE_STEWARD_API_SECRET)",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "authorizationServicesEnabled": true,
      "fullScopeAllowed": false,
      "defaultClientScopes": ["basic"],
      "optionalClientScopes": [],
      "redirectUris": [],
      "webOrigins": [],
      "authorizationSettings": {
        "allowRemoteResourceManagement": false,
        "policyEnforcementMode": "ENFORCING",
        "decisionStrategy": "UNANIMOUS",
        "scopes": [
          {
            "name": "view"
          },
          {
            "name": "review"
          }
        ],
        "resources": [
          {
            "name": "opportunity:SE",
            "displayName": "Opportunities in SE",
            "type": "urn:steward:opportunity",
            "ownerManagedAccess": false,
            "attributes": {
              "market": ["SE"]
            },
            "scopes": [
              {
                "name": "view"
              },
              {
                "name": "review"
              }
            ]
          },
          {
            "name": "opportunity:NG",
            "displayName": "Opportunities in NG",
            "type": "urn:steward:opportunity",
            "ownerManagedAccess": false,
            "attributes": {
              "market": ["NG"]
            },
            "scopes": [
              {
                "name": "view"
              },
              {
                "name": "review"
              }
            ]
          },
          {
            "name": "opportunity:GB",
            "displayName": "Opportunities in GB",
            "type": "urn:steward:opportunity",
            "ownerManagedAccess": false,
            "attributes": {
              "market": ["GB"]
            },
            "scopes": [
              {
                "name": "view"
              },
              {
                "name": "review"
              }
            ]
          },
          {
            "name": "opportunity:DE",
            "displayName": "Opportunities in DE",
            "type": "urn:steward:opportunity",
            "ownerManagedAccess": false,
            "attributes": {
              "market": ["DE"]
            },
            "scopes": [
              {
                "name": "view"
              },
              {
                "name": "review"
              }
            ]
          }
        ],
        "policies": [
          {
            "name": "approvers",
            "type": "role",
            "logic": "POSITIVE",
            "decisionStrategy": "UNANIMOUS",
            "config": {
              "roles": "[{\"id\": \"steward-approver\", \"required\": true}]",
              "fetchRoles": "true"
            }
          },
          {
            "name": "market SE",
            "type": "group",
            "logic": "POSITIVE",
            "decisionStrategy": "UNANIMOUS",
            "config": {
              "groups": "[{\"path\": \"/markets/SE\", \"extendChildren\": false}]",
              "groupsClaim": ""
            }
          },
          {
            "name": "market NG",
            "type": "group",
            "logic": "POSITIVE",
            "decisionStrategy": "UNANIMOUS",
            "config": {
              "groups": "[{\"path\": \"/markets/NG\", \"extendChildren\": false}]",
              "groupsClaim": ""
            }
          },
          {
            "name": "market GB",
            "type": "group",
            "logic": "POSITIVE",
            "decisionStrategy": "UNANIMOUS",
            "config": {
              "groups": "[{\"path\": \"/markets/GB\", \"extendChildren\": false}]",
              "groupsClaim": ""
            }
          },
          {
            "name": "market DE",
            "type": "group",
            "logic": "POSITIVE",
            "decisionStrategy": "UNANIMOUS",
            "config": {
              "groups": "[{\"path\": \"/markets/DE\", \"extendChildren\": false}]",
              "groupsClaim": ""
            }
          },
          {
            "name": "review in SE",
            "type": "scope",
            "logic": "POSITIVE",
            "decisionStrategy": "UNANIMOUS",
            "config": {
              "resources": "[\"opportunity:SE\"]",
              "scopes": "[\"review\"]",
              "applyPolicies": "[\"approvers\", \"market SE\"]"
            }
          },
          {
            "name": "review in NG",
            "type": "scope",
            "logic": "POSITIVE",
            "decisionStrategy": "UNANIMOUS",
            "config": {
              "resources": "[\"opportunity:NG\"]",
              "scopes": "[\"review\"]",
              "applyPolicies": "[\"approvers\", \"market NG\"]"
            }
          },
          {
            "name": "review in GB",
            "type": "scope",
            "logic": "POSITIVE",
            "decisionStrategy": "UNANIMOUS",
            "config": {
              "resources": "[\"opportunity:GB\"]",
              "scopes": "[\"review\"]",
              "applyPolicies": "[\"approvers\", \"market GB\"]"
            }
          },
          {
            "name": "review in DE",
            "type": "scope",
            "logic": "POSITIVE",
            "decisionStrategy": "UNANIMOUS",
            "config": {
              "resources": "[\"opportunity:DE\"]",
              "scopes": "[\"review\"]",
              "applyPolicies": "[\"approvers\", \"market DE\"]"
            }
          },
          {
            "name": "view in SE",
            "type": "scope",
            "logic": "POSITIVE",
            "decisionStrategy": "UNANIMOUS",
            "config": {
              "resources": "[\"opportunity:SE\"]",
              "scopes": "[\"view\"]",
              "applyPolicies": "[\"market SE\"]"
            }
          },
          {
            "name": "view in NG",
            "type": "scope",
            "logic": "POSITIVE",
            "decisionStrategy": "UNANIMOUS",
            "config": {
              "resources": "[\"opportunity:NG\"]",
              "scopes": "[\"view\"]",
              "applyPolicies": "[\"market NG\"]"
            }
          },
          {
            "name": "view in GB",
            "type": "scope",
            "logic": "POSITIVE",
            "decisionStrategy": "UNANIMOUS",
            "config": {
              "resources": "[\"opportunity:GB\"]",
              "scopes": "[\"view\"]",
              "applyPolicies": "[\"market GB\"]"
            }
          },
          {
            "name": "view in DE",
            "type": "scope",
            "logic": "POSITIVE",
            "decisionStrategy": "UNANIMOUS",
            "config": {
              "resources": "[\"opportunity:DE\"]",
              "scopes": "[\"view\"]",
              "applyPolicies": "[\"market DE\"]"
            }
          }
        ]
      }
    },
    {
      "clientId": "steward-fapi",
      "name": "Steward, financial grade (mTLS)",
      "description": "Steward under the FAPI 2 Security Profile (policy steward-fapi-mtls): private_key_jwt with the certificate registered here, PAR, PKCE S256, https URIs, consent, and the access token bound to the client certificate (K11).",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-jwt",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "consentRequired": true,
      "frontchannelLogout": false,
