  "authenticationFlows": [
    {
      "alias": "steward-browser",
      "description": "The browser flow Steward's sign-in goes through: cookie, identity-provider redirector, then the forms. A copy of the built-in flow so that K5 can add the market second factor without touching a built-in.",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-cookie",
          "requirement": "ALTERNATIVE",
          "priority": 10,
          "userSetupAllowed": false,
          "authenticatorFlow": false
        },
        {
          "authenticator": "identity-provider-redirector",
          "requirement": "ALTERNATIVE",
          "priority": 20,
          "userSetupAllowed": false,
          "authenticatorFlow": false
        },
        {
          "flowAlias": "steward-browser forms",
          "requirement": "ALTERNATIVE",
          "priority": 30,
          "userSetupAllowed": false,
          "authenticatorFlow": true
        }
      ]
    },
    {
      "alias": "steward-browser forms",
      "description": "Username, password, the second factor the user's market requires, then a TOTP for the users who have one.",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-username-password-form",
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false,
          "authenticatorFlow": false
        },
        {
          "authenticator": "steward-market-second-factor",
          "authenticatorConfig": "market second factor",
          "requirement": "REQUIRED",
          "priority": 15,
          "userSetupAllowed": false,
          "authenticatorFlow": false
        },
        {
          "flowAlias": "steward-browser second factor",
          "requirement": "CONDITIONAL",
          "priority": 20,
          "userSetupAllowed": false,
          "authenticatorFlow": true
        }
      ]
    },
    {
      "alias": "steward-browser second factor",
      "description": "A second factor when the user has one: a passkey (WebAuthn) or an OTP, either; K5's market step is beside this.",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "conditional-user-configured",
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false,
          "authenticatorFlow": false
        },
        {
          "authenticator": "webauthn-authenticator",
          "requirement": "ALTERNATIVE",
          "priority": 15,
          "userSetupAllowed": false,
          "authenticatorFlow": false
        },
        {
          "authenticator": "auth-otp-form",
          "requirement": "ALTERNATIVE",
          "priority": 20,
          "userSetupAllowed": false,
          "authenticatorFlow": false
        }
      ]
    },
    {
      "alias": "steward first broker login",
      "description": "The first time a brokered identity arrives: the profile as the provider sent it, then a new account when nothing matches, or the account with that email, linked. Right only because both providers verify the email.",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "idp-review-profile",
          "authenticatorConfig": "steward review profile",
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false,
          "authenticatorFlow": false
        },
        {
          "flowAlias": "steward first broker login: create or link",
          "requirement": "REQUIRED",
          "priority": 20,
          "userSetupAllowed": false,
          "authenticatorFlow": true
        }
      ]
    },
    {
      "alias": "steward first broker login: create or link",
      "description": "A new account when the email is new; the existing account, linked automatically, when it is not.",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "idp-create-user-if-unique",
          "authenticatorConfig": "steward create user if unique",
          "requirement": "ALTERNATIVE",
          "priority": 10,
          "userSetupAllowed": false,
          "authenticatorFlow": false
        },
        {
          "authenticator": "idp-auto-link",
          "requirement": "ALTERNATIVE",
          "priority": 20,
          "userSetupAllowed": false,
          "authenticatorFlow": false
        }
      ]
    }
  ],
  "eventsEnabled": true,
  "eventsListeners": ["jboss-logging", "steward-audit"],
  "enabledEventTypes": [],
  "adminEventsEnabled": true,
  "adminEventsDetailsEnabled": false,
  "authenticatorConfig": [
