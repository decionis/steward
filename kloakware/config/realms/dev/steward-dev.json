{
  "realm": "steward",
  "sslRequired": "none",
  "clients": [
    {
      "clientId": "kloakware-smoke",
      "name": "Smoke test (dev and CI only)",
      "description": "Dev and CI only: the password grant the smoke test signs in with. Never applied to a deployed realm; a deployment applies steward.json alone.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "redirectUris": [],
      "webOrigins": [],
      "defaultClientScopes": [
        "basic",
        "profile",
        "email",
        "roles",
        "web-origins",
        "acr",
        "market"
      ],
      "optionalClientScopes": []
    }
  ],
  "users": [
    {
      "username": "erin.example",
      "email": "erin@example.test",
      "firstName": "Erin",
      "lastName": "Example",
      "enabled": true,
      "emailVerified": true,
      "realmRoles": ["steward-admin", "steward-approver"],
      "credentials": [
        {
          "type": "password",
          "value": "$(env:KLOAKWARE_DEV_USER_PASSWORD)",
          "temporary": false
        }
      ],
      "groups": ["/markets/SE"]
    },
    {
      "username": "ops.example",
      "email": "ops@example.test",
      "firstName": "Ola",
      "lastName": "Example",
      "enabled": true,
      "emailVerified": true,
      "groups": ["/markets/SE"],
      "realmRoles": ["steward-operations"],
      "credentials": [
        {
          "type": "password",
          "value": "$(env:KLOAKWARE_DEV_USER_PASSWORD)",
          "temporary": false
        }
      ]
    },
    {
      "username": "audit.example",
      "email": "audit@example.test",
      "firstName": "Ade",
      "lastName": "Example",
      "enabled": true,
      "emailVerified": true,
      "groups": ["/markets/SE"],
      "realmRoles": ["steward-audits"],
      "credentials": [
        {
          "type": "password",
          "value": "$(env:KLOAKWARE_DEV_USER_PASSWORD)",
          "temporary": false
        }
      ]
    }
  ]
}
