# The SiteMinder user directory, as `ldapsearch -LLL` exports it from the
# policy server's user store (an OpenLDAP here; eDirectory and Active Directory
# differ in attribute names, not in shape). SiteMinder keeps no passwords of
# its own: they are the directory's userPassword values, salted SHA-1, SHA-256
# and SHA-512 in the {SSHA} family, which the legacy-ssha provider verifies.
# Roles are group memberships, the market is the country attribute. Dev
# fixture: every password is Siteminder-Sign-In-2026!. erin.example exists in
# the realm already and is skipped; dup.legacy carries maria's email and is
# reported as a duplicate.

dn: uid=maria.legacy,ou=people,dc=legacy,dc=example
objectClass: inetOrgPerson
uid: maria.legacy
cn: Maria Legacy
givenName: Maria
sn: Legacy
mail: maria.legacy@example.test
c: SE
memberOf: cn=steward-operator,ou=groups,dc=legacy,dc=example
userPassword:: e1NTSEF9VEJxR2M5SlJuOHc3SVZRNHhrSGVZNXVyazcxdFlYSnBZUzF6WVd4MExUQXg=

