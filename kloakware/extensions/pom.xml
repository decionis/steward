<?xml version="1.0" encoding="UTF-8"?>
<!--
  The extensions, one module each, built together by the Dockerfile's Maven
  stage: `mvn -f extensions/pom.xml package` reads the parent as a parent and
  needs no other module of the reactor in the image's build context.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.decionis.kloakware</groupId>
    <artifactId>kloakware</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>kloakware-extensions</artifactId>
  <packaging>pom</packaging>
  <name>Kloakware: the extensions</name>

  <modules>
    <module>token-mapper-market</module>
    <module>event-listener</module>
    <module>authenticator-market-mfa</module>
    <module>password-hash-legacy</module>
    <module>user-storage-steward</module>
    <module>theme-steward</module>
  </modules>
</project>
