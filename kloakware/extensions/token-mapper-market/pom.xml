<?xml version="1.0" encoding="UTF-8"?>
<!--
  The steward claim mapper: a ProtocolMapper SPI that writes one compact
  claim, `steward`, with the user's Steward roles and markets, into the ID
  token, the access token (lightweight included), userinfo and introspection.
  What a payment dashboard needs from a token and nothing else (docs/Tokens.md).

  Keycloak's own artifacts are `provided`: the server supplies them at run
  time, and the JAR built here carries only this code. The Dockerfile compiles
  it in; nothing is dropped into a running container.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.decionis.kloakware</groupId>
    <artifactId>kloakware</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>kloakware-token-mapper-market</artifactId>
  <name>Kloakware: the steward claim mapper</name>

  <dependencies>
    <dependency>
      <groupId>org.keycloak</groupId>
      <artifactId>keycloak-core</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.keycloak</groupId>
      <artifactId>keycloak-server-spi</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.keycloak</groupId>
      <artifactId>keycloak-server-spi-private</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.keycloak</groupId>
      <artifactId>keycloak-services</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>kloakware-token-mapper-market</finalName>
  </build>
</project>
