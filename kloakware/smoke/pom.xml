<?xml version="1.0" encoding="UTF-8"?>
<!--
  The smoke test for the server image: builds server/Dockerfile, starts it
  against PostgreSQL, applies the realm with keycloak-config-cli, signs the
  seeded dev user in at the token endpoint and reads the roles back. Nothing
  here ships; every dependency is test scope.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.decionis.kloakware</groupId>
    <artifactId>kloakware</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>kloakware-smoke</artifactId>
  <name>Kloakware smoke test</name>

  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- The signature the audit listener puts on a record, verified as Steward does. -->
    <dependency>
      <groupId>com.decionis.kloakware</groupId>
      <artifactId>kloakware-event-listener</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <systemPropertyVariables>
            <!-- The kloakware directory: where server/Dockerfile and config/realms live. -->
            <kloakware.root>${project.basedir}/..</kloakware.root>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
