# Dev-only values for the compose file in this directory. Copy to .env.
# Every one of them is for a laptop: a deployment takes its secrets from
# the secret store the Terraform in ../terraform wires, never from a file.
KLOAKWARE_DB_PASSWORD=8f7c554f8451588dbc55e7f9c0c94038
KLOAKWARE_BOOTSTRAP_ADMIN_PASSWORD=203246fd6c849f178292e1e582e80312
KLOAKWARE_STEWARD_API_SECRET=b1c5f36dcbac855e0aeec99ccd4d6f7131db225b034ebba0
# The audit listener signs every record it posts to Steward with this; Steward's STEWARD_AUDIT_WEBHOOK_SECRET is the same value.
KLOAKWARE_AUDIT_WEBHOOK_SECRET=c9c2489703619bc77f007d89a83383b3e37b4a8850a2602c
KLOAKWARE_STEWARD_CLIENT_SECRET=603ce6799dc943e9d7c657690f545a541dca49e5418287f4
# The seeded users, all in market SE: erin.example (steward-admin, steward-approver), ops.example
# (steward-operations), audit.example (steward-audits). One password for the three.
# The realm's password policy needs 12+ characters with a digit, lower and upper case and a symbol.
KLOAKWARE_DEV_USER_PASSWORD=Kw!1-95548900afebc278a799eb4c
# legacy.example signs in with a legacy salted SHA-256 hash seeded in the dev overlay; its password is
# Legacy-Sign-In-2026! and the first sign-in rehashes it to argon2. sven.example works market SE and
# confirms in the BankID simulator.
# The corporate identity provider stood in by the corp realm (K6): the broker client's secret,
# the directory administrator's password the ldap federation binds with, and the password of the
# read-only user on Steward's database the steward-users storage reads. The directory's people,
# anna.directory (SE, steward-operator) and bo.directory (DE), and the corp realm's carl.corp (SE,
# operator) and erin.corp (DE, approver; the same email as erin.example, so the first sign-in links
# the two) take KLOAKWARE_DEV_USER_PASSWORD. local.example is a Steward local account seeded in the
# stand-in database; its password is Local-Account-2026!
KLOAKWARE_BROKER_CLIENT_SECRET=7d2f4b6a9c1e3058a4b7c9d1e2f3a4b5c6d7e8f9a0b1c2d3
KLOAKWARE_LDAP_BIND_PASSWORD=Ld!1-4c0b1d9e8f7a6b5c4d3e2f1a0b9c8d7e
STEWARD_DB_PASSWORD=5e9a1c3d7b2f4e6a8c0d2b4f6a8e0c2d
# The kloakware-ci service account in the master realm (K11): what the promotion pipeline applies the
# realms as once the bootstrap administrator has created it; only the two realms' management roles.
KLOAKWARE_CI_CLIENT_SECRET=fc03c7c5ad5e289a2c24a69df6827dc5
# Grafana's administrator on the laptop stack (K10); viewing needs no sign-in.
KLOAKWARE_GRAFANA_ADMIN_PASSWORD=Gf!1-9b4e2c7d1a5f8e3b6c0d2a4f6e8b1c3d
# Where Steward runs: the realm's redirect and logout URIs are built from it. For the backchannel
# logout to reach a Steward on this machine, http://host.docker.internal:3000 (and the same value
# as Steward's STEWARD_PUBLIC_URL).
STEWARD_URL=http://localhost:3000
