# Dev-only values for the compose file in this directory. Copy to .env.
# Every one of them is for a laptop: a deployment takes its secrets from
# the secret store the Terraform in ../terraform wires, never from a file.
KLOAKWARE_DB_PASSWORD=8f7c554f8451588dbc55e7f9c0c94038
KLOAKWARE_BOOTSTRAP_ADMIN_PASSWORD=203246fd6c849f178292e1e582e80312
KLOAKWARE_STEWARD_CLIENT_SECRET=603ce6799dc943e9d7c657690f545a541dca49e5418287f4
# The seeded operator, erin.example, holds steward-admin and steward-approver and works market SE.
# The realm's password policy needs 12+ characters with a digit, lower and upper case and a symbol.
KLOAKWARE_DEV_USER_PASSWORD=Kw!1-95548900afebc278a799eb4c
# Where Steward runs: the realm's redirect and logout URIs are built from it.
STEWARD_URL=http://localhost:3000
