# `demo` uses deterministic fixtures. Production defaults to `live`.
STEWARD_DATA_MODE=demo

# Required in live mode.
DECIONIS_API_BASE_URL=https://api.decionis.com

# Optional server-to-server credential. Prefer a signed user session in production.
DECIONIS_STEWARD_SERVICE_TOKEN=

# Browser session cookies expected from the Decionis identity handoff.
STEWARD_ACCESS_TOKEN_COOKIE=decionis_access_token
STEWARD_ORG_ID_COOKIE=decionis_org_id

# External Decionis sign-in endpoint used by /sign-in.
NEXT_PUBLIC_DECIONIS_SIGN_IN_URL=https://decionis.com/sign-in

# Where collected signals are forwarded: the Decionis signal ingress. Both values are issued
# together by a deployment bundle (https://decionis.com/docs/signal-mapping). Set both or neither.
DECIONIS_CONNECTOR_ID=
DECIONIS_WEBHOOK_SECRET=
# Only if the bundle's webhook URL differs from <DECIONIS_API_BASE_URL>/v1/signals/webhooks/<id>.
DECIONIS_WEBHOOK_URL=
