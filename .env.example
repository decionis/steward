# `demo` uses deterministic fixtures. Production defaults to `live`.
STEWARD_DATA_MODE=demo

# Required in live mode.
DECIONIS_API_BASE_URL=https://api.decionis.com

# Optional server-to-server credential. Prefer a signed user session in production.
DECIONIS_STEWARD_SERVICE_TOKEN=

# Browser session cookies expected from the Decionis identity handoff.
STEWARD_ACCESS_TOKEN_COOKIE=decionis_access_token
STEWARD_ORG_ID_COOKIE=decionis_org_id

# External Decionis sign-in endpoint used by /sign-in.
NEXT_PUBLIC_DECIONIS_SIGN_IN_URL=https://decionis.com/sign-in

# Where collected signals are forwarded: the Decionis signal ingress. Both values are issued
# together by a deployment bundle (https://decionis.com/docs/signal-mapping). Set both or neither.
DECIONIS_CONNECTOR_ID=
DECIONIS_WEBHOOK_SECRET=
# Only if the bundle's webhook URL differs from <DECIONIS_API_BASE_URL>/v1/signals/webhooks/<id>.
DECIONIS_WEBHOOK_URL=

# Where Steward's own records live (users, sessions, sources, decisions, reviews, activities;
# never a signal's content). Unset outside demo mode: the embedded database under STEWARD_DATA_DIR.
# Otherwise postgres://, mysql://, mssql://, oracle:// or sqlite:///path/steward.sqlite.
STEWARD_DATABASE_URL=
STEWARD_DATA_DIR=./data
# on-start (default) applies migrations when the server starts; off refuses to serve a schema that is behind.
STEWARD_DATABASE_MIGRATE=on-start

# The Decionis workspace Steward acts for on the published Protocol, from the deployment bundle.
# The key and the org id come together; set both or neither. The database is the other source.
DECIONIS_API_KEY=
DECIONIS_ORG_ID=
DECIONIS_WORKSPACE_NAME=

# Sign-in through kloakware, the Keycloak access service the operator runs (docs/Kloakware.md).
# Set all three or none; the secret is a mounted value, never a file in the tree. Needs
# DECIONIS_API_KEY and DECIONIS_ORG_ID: a session is scoped to the configured organisation.
# Under the financial-grade profile the secret gives way to a private key: STEWARD_OIDC_CLIENT_PRIVATE_KEY
# (a PKCS#8 PEM, newlines as \n) or STEWARD_OIDC_CLIENT_PRIVATE_KEY_FILE (its path), and Steward signs a
# client assertion instead of posting the secret. One of the two ways, never both.
STEWARD_OIDC_ISSUER_URL=
STEWARD_OIDC_CLIENT_ID=steward
STEWARD_OIDC_CLIENT_SECRET=
# Steward's origin as the browser and the issuer see it, for the redirect URI; unset derives it per request.
STEWARD_PUBLIC_URL=
# The cookie carrying Steward's own session id.
STEWARD_SESSION_COOKIE=steward_session

# Kloakware's audit listener posts every sign-in, sign-out and failure to /api/activities/kloakware,
# signed with this secret (its KLOAKWARE_AUDIT_WEBHOOK_SECRET). Unset: the endpoint answers 404.
STEWARD_AUDIT_WEBHOOK_SECRET=
