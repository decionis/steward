{
  "name": "@decionis/steward",
  "version": "0.2.0",
  "private": true,
  "description": "Signal capture and decisioning for customer operations teams \u2014 correlate usage, support and CRM evidence, surface churn and expansion before the customer calls, and route every operator review through a Decionis policy verdict.",
  "license": "Apache-2.0",
  "author": "Decionis, Inc. (https://decionis.com)",
  "homepage": "https://github.com/decionis/steward#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/decionis/steward.git"
  },
  "bugs": {
    "url": "https://github.com/decionis/steward/issues"
  },
  "type": "module",
  "packageManager": "pnpm@9.15.3",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:automation": "node --test test/automation/OpenPullRequest.test.mjs",
    "test:watch": "vitest",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "licenses:check": "node scripts/CheckLicensePolicy.mjs",
    "licenses:list": "pnpm licenses list --prod",
    "verify": "pnpm format && pnpm lint && pnpm typecheck && pnpm discovery && pnpm test:automation && pnpm test && pnpm build",
    "discovery": "node scripts/CheckDiscovery.mjs",
    "screenshots": "node scripts/CaptureScreenshots.mjs",
    "sbom": "node scripts/GenerateSbom.mjs decionis-steward.cdx.json",
    "prepare": "git config core.hooksPath .githooks || true",
    "links:check": "node scripts/CheckMarkdownLinks.mjs",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "lucide-react": "^1.31.0",
    "next": "^16.3.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.16.0",
    "eslint-config-next": "^15.1.3",
    "jsdom": "^25.0.1",
    "playwright": "^1.63.0",
    "prettier": "^3.9.8",
    "typescript": "^5.6.3",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "overrides": {
      "postcss": "^8.5.26",
      "nanoid": "^3.3.18",
      "sharp": "^0.35.4",
      "vite": "^6.4.3",
      "esbuild": "^0.25.0",
      "js-yaml": "^4.3.2",
      "brace-expansion@1": "^1.1.18",
      "brace-expansion@5": "^5.0.9"
    }
  }
}
